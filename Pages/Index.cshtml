                                <datalist id="dlMDoc" name="lblMDoc">
                                    @foreach (var res in Model.lstDoctors)
                                    {
                                        <option value="@res.DoctorKey" label="@res.DoctorName" />
                                    }
                                </datalist>
                            </td>
                            <td style="padding:10px; align-content:flex-end;">Specialty:</td>
