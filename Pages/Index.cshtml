                            <td style="padding:10px; align-content:flex-end;">Fax:</td>
                            <td style="padding:10px; align-content:flex-start;"><label id="lblMFax" name="lblMFax" class="form-control" /></td>
                        </tr>
                        <tr>
                            <td style="padding:10px; align-content:flex-end;">Driver:</td>
                            <td style="padding:10px; align-content:flex-start;">
                                <input type="hidden" id="hdnMDriver" name="hdnMDriver" value="" />
                                <input type="text" id="txtMDriver" name="txtMDriver" list="dlMDriver" class="form-control" onchange="ChangeFilter(this);" />
                                <datalist id="dlMDriver" name="lblMDriver">
                                    @foreach (var res in Model.lstDrivers)
                                    {
                                        <option value="@res.DriverID" label="@res.DriverName" />
                                    }
                                </datalist>
                            </td>
                            <td style="padding:10px; align-content:flex-end;">Pick up:</td>
