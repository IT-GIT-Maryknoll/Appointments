                         </td>

                        <td style="width: 85%" id="tdPermissions">
                            <div id="divPermissions" style="height: 600px; overflow-y: auto; text-align:center; display:none;" role="tabpanel" aria-labelledby="divPermissions">
                                        <table id="tblGroupPermissions" class="table table-bordered" style="width:100%; ">
                                        <tr>
                                            <th style="width:150px; background-color:royalblue; color:white;">Table Name</th>
                                            <th style="background-color:royalblue; color:white;">View</th>
                                            <th style="background-color:royalblue; color:white;">Add</th>
                                            <th style="background-color:royalblue; color:white;">Edit</th>
                                            <th style="background-color:royalblue; color:white;">Delete</th>
                                            </tr>
                                                @for (int i = 0; i < Model.lstTableIDs.Count; i++)
                                                {
                                                    <tr>
                                                        <td style="text-align:left;">@Model.lstTables[i]</td>
                                                        <td><input type="checkbox" name="checkPerm" id="check*V*@Model.lstTableIDs[i]" onclick="CheckColumn(this);" /></td>
                                                        <td><input type="checkbox" name="checkPerm" id="check*A*@Model.lstTableIDs[i]" onclick="CheckColumn(this);" /></td>
                                                        <td><input type="checkbox" name="checkPerm" id="check*E*@Model.lstTableIDs[i]" onclick="CheckColumn(this);" /></td>
                                                        <td><input type="checkbox" name="checkPerm" id="check*D*@Model.lstTableIDs[i]" onclick="CheckColumn(this);" /></td>
                                                    </tr>
                                                }
                                        </table>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
