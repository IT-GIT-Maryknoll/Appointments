    <script>
        var appts = [];
        $(document).ready(function () {
            let date = new Date();
            let month = date.getMonth() + 1;
            let year = date.getFullYear();

            @if(Model.lblDate == null || Model.lblDate.Trim().Length != 7) { <text>SetCurrentDateToSelector();FetchEventAndRenderCalendar(year, month);</text> }
            else { <text>FetchEventAndRenderCalendar(@Model.lblDate.Substring(0,4), @Model.lblDate.Substring(5,2));</text> }
            
            function FetchEventAndRenderCalendar(year, month) {
                $.ajax({
                    type: "GET",
                    url: "Index?handler=GetAppointments",
                   // data: { },
                    success: function (data) {
                        appts = [];
                        $.each(data, function (i, v) {
                            appts.push({
                                eventID: v.eventID,
                                title: v.subject,
                                description: v.description,
                                start: moment(v.start),
                                end: null,
                                color: v.themeColor,
                                allDay: v.isFullDay
                            });
                        });
                        GenerateCalendar(appts, new Date(year, month - 1));
                    },
                    error: function (error) {
                        alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                    }
               });
            }

            function SetCurrentDateToSelector() {
                let date = new Date();
                let month = date.getMonth() + 1;
                let year = date.getFullYear();

                if (month < 10) month = "0" + month;

                var today = year + "-" + month;
                $('#dtpSelector').val(today);
            }
     //             this.textBox1.AutoCompleteMode = AutoCompleteMode.SuggestAppend;
     // this.textBox1.AutoCompleteSource = AutoCompleteSource.CustomSource;
   
             var sCust = "";
            function GenerateCalendar(appts, date) {
                var sView = "month"; 
                if ($('#calendar').fullCalendar('getCalendar').view) {
                    //if (appts.buttonText == 'month') { sView = 'month'; alert(sView); }
                    //else {
                    /*alert("cur cust - " + sCust);*/
                    if (sCust == "") { sView = $('#calendar').fullCalendar('getCalendar').view.name; }
                    else sCust = "";
                    //}
                    
                }
                $('#calendar').fullCalendar('destroy');
                $('#calendar').fullCalendar({
                    contentHeight: 600,
                    contentWidth: 1630,
                    defaultDate: date,
                    timeFormat: 'h(:mm)a',
                    displayEventTime: false,
                    defaultView: sView,
                    customButtons: {
                        today: {
                            text: 'today',
                            click: function () {
                                let date = new Date();
                                $('#calendar').fullCalendar('gotoDate', date);
                                SetCurrentDateToSelector();
                                    $('#btnSearch').click();
                                // FetchEventAndRenderCalendar(date.getFullYear(), date.getMonth() + 1);
                            }
                        },
                        month: {
                            text: 'month',
                            click: function () {
                                let date = $('#calendar').fullCalendar('getDate');
                                /*alert('cust'); */sCust = "cust";
                                sView = 'month';
                                updateYearMonth();
                                //$('#calendar').fullCalendar('getCalendar').defaultView = 'month';
                                //FetchEventAndRenderCalendar(date._d.getFullYear(), date._d.getMonth() + 2);
                            }
                        },
                    },
                    header: {
                        left: 'prev,next,today',
                        center: 'title',
                        right: 'month,listMonth'     /* ,basicWeek,basicDay */
                    },
                    eventLimit: 100,
                   // eventColor: '#378006',
                    eventRender: function (event, element, view) {
                        var title = "";
                        if (typeof element.find('.fc-title')[0] === 'object') {
                            let title = element.find('.fc-title')[0].textContent;
                            element.find('.fc-title')[0].textContent = "";
                            element.find('.fc-title').append(title);
                        }
                        if (typeof element.find('.fc-list-item-title') === 'object') {
                            event.allDay = true; 
                            //element.find('.fc-title').html(event.title);
                            element.find('.fc-list-item-title').html(event.title);
                            if (element.find('.fc-list-item-title').length > 0) {
                                element.find('.fc-list-item-title').parent('tr').addClass('linkshow');
                            }
                        }
                    },

                    events: appts,
                    eventContent: function (event) {
                        return { html: event.appt.title };
                    },
                    eventClick: function (calEvent, jsEvent, view) {
                           selectedEvent = calEvent; 
                         $.ajax({
                             type: "GET",
                                url: "index?handler=GetAppointmentById&id=" + calEvent.eventID,
                             data: { id: calEvent.eventID },
                                  success: function (eventData) {
                                       document.getElementById('cmbMAddr').options.length = 0;
                                       for(i= 0; i < eventData.locations.length; i++) {
                                            $('#cmbMAddr').append($('<option>', {
                                                 value: eventData.locations[i].locationID,
                                                text: eventData.locations[i].street
                                            }));
                                          }
                                      if(eventData.id > 0) $('#modalTitle').text("Edit Appointment");
                                      else {
                                          $('#modalTitle').text("New Appointment");
                                          $('#cmdDelete').hide();
                                          $('#divEdit').hide();
                                      }
                                      $('#hdnEventID').val(eventData.id);
                                      $('#txtMDate').val(new Date(eventData.apptTime).toISOString().substring(0, 10));
                                      $('#txtMTime').val(new Date(eventData.apptTime).toTimeString().substring(0, 5));
                                      $('#txtMRes').val(eventData.fullName);
                                      $('#cmbMStatus').val(eventData.status);
                                      $('#txtMDriver').val(eventData.driverName);
                                      $('#hdnMRes').val(eventData.residentKey);
                                      $('#hdnMDoc').val(eventData.doctorKey);
                                      $('#txtMDoc').val(eventData.doctorName);
                                      $('#lblMSpecialty').text(eventData.specialty);
                                      $('#cmbMAddr').val(eventData.locationID);  // .trigger('change');
                                      $('#lblMCity').text(eventData.city);
                                      $('#lblMPhone').text(eventData.phone);
                                      $('#lblMFax').text(eventData.fax);
                                      $('#txtMPickup').val(eventData.depart != null ? new Date(eventData.depart).toTimeString().substring(0, 5) : '');
                                      $('#cmbMPrep').val(eventData.prepID);
                                      $('#cmbMApptType').val(eventData.apptType);
                                      $('#txtMNotes').val(eventData.notes);
                                    $('#lblMEditDate').text(new Date(eventData.modDate).toLocaleDateString());
                                    $('#lblMEditBy').text(eventData.modifiedBy);
                                    $('#lblMCreateDate').text(new Date(eventData.addDate).toLocaleDateString());
                                    $('#lblMCreateBy').text(eventData.createdBy);

                             },
                            error: function (error) {
                                alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                             }
                       });
                             $('#myModal').modal('show');
                    },
                    selectable: true,
                    select: function (start, end) {
                        selectedEvent = {
                            eventID: 0,
                            title: '',
                            description: '',
                            start: start,
                            end: end,
                            allDay: false,
                            color: ''
                        };
                        //openAddEditForm();
                        $('#calendar').fullCalendar('unselect');
                    },
                    editable: true,

                    dayClick: function (date, jsEvent, view) {
                        //let date = $('#calendar').fullCalendar('getDate');
                           $('#txtMDate').val(new Date(date).toISOString().substring(0, 10));
                           $('#txtMTime').val(new Date().toTimeString().substring(0, 5));
                              // $('#txtMDate').val(date.toISOString().substring(0, 10));
                              // $('#txtMTime').val(date.toTimeString().substring(0, 5));

                           $('#myModal').modal('show');
                        // $('#messagePastDate').hide();
                        // $('#dtpChurchDate').val(date.format());
                    }
                });
            }

                $('body').on('click', 'button.fc-prev-button', function () {
                      updateYearMonth(); $('#btnSearch').click();
               });

               function updateYearMonth() {
                   let date = $('#calendar').fullCalendar('getDate');
                   let year = date._d.getFullYear();
                   let month = date._d.getMonth() + 2;
                   if (month > 12) {
                       month = 1;
                       year += 1;
                   }

                   if (month < 10) {
                       month = "0" + month;
                   }

                   let nDate = year + '-' + month;
                   $('#dtpSelector').val(nDate);
                   FetchEventAndRenderCalendar(year, month);
               }
                  $('body').on('click', 'button.fc-next-button', function () {updateYearMonth(); $('#btnSearch').click();});

      });
            function ChangeFilter(txb){
                var res = txb.value;
                var id = txb.id.replace('txt','');
               $('#hdn' + id).val('');
                 const option = document.getElementById('dl' + id).querySelector(`[value="${res}"]`);
               if (option) {
                   var lbl = option.getAttribute('label');
                   $('#txt' + id).val(lbl);
                   $('#hdn' + id).val(res);
                }
             }
             function clearFilter() {
                    $('#dtpSelector').val(new Date().getFullYear() + '-' + ("0" + (new Date().getMonth() + 1)).slice(-2));
                    $("#txtResident").val('');
                    $("#hdnResident").val('');
                    $("#txtDoctor").val('');
                    $("#hdnDoctor").val('');
                    $("#cmbApptType").val('');
                 //               SetCurrentDateToSelector();
            }
            function changeLocation(locID){
                $.ajax({
                type: "GET",
                    url: "index?handler=GetLocationById&id=" + locID,
                data: { id: locID },
                        success: function (eventData) {
                            $('#lblMCity').text(eventData.city);
                            $('#lblMPhone').text(eventData.phone);
                            $('#lblMFax').text(eventData.fax);
                            },
                            error: function (error) {
                                alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                            }
                    });
            }
            function changeDoctor(docID){
                $.ajax({
                    type: "GET",
                    url: "index?handler=GetDoctorById&id=" + docID,
                    data: { id: docID },
                    success: function (eventData) {
                        var newLocation = 0;
                        document.getElementById('cmbMAddr').options.length = 0;
                        for(i= 0; i < eventData.locations.length; i++) {
                            if (i === 0) {
                                newLocation = eventData.locations[i].locationID;
                            }
                            $('#cmbMAddr').append($('<option>', {
                                value: eventData.locations[i].locationID,
                                text: eventData.locations[i].street
                            }));
                          }
                             debugger;
                        $('#lblMSpecialty').text(eventData.specialty);
                        changeLocation(newLocation);
                    },
                    error: function (error) {
                        alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                    }
                   });
            }
            function clearForm(){
                $('#hdnEventID').val('');
                $('#txtMDate').val('');
                $('#txtMTime').val('');
                $('#txtMRes').val('');
                $('#cmbMStatus').val('Booked');
                $('#txtMDriver').val('');
                $('#hdnMRes').val('');
                $('#hdnMDoc').val('');
                $('#txtMDoc').val('');
                $('#lblMSpecialty').text('');
                $('#cmbMAddr').val('');  // .trigger('change');
                $('#lblMCity').text('');
                $('#lblMPhone').text('');
                $('#lblMFax').text('');
                $('#txtMPickup').val('');
                $('#cmbMPrep').val('');
                $('#cmbMApptType').val('');
                $('#txtMNotes').val('');
                $('#lblMEditDate').text('');
                $('#lblMEditBy').text('');
                $('#lblMCreateDate').text('');
                $('#lblMCreateBy').text('');
            }
            function deleteAppointment() {
                if ($('#hdnEventID').val() > 0) {
                    if (confirm("Are you sure you want to delete this appointment?")) {
                        $.ajax({
                            type: "POST",
                            url: "index?handler=DeleteAppointment",
                            data: { id: $('#hdnEventID').val() },
                            success: function (data) {
                                alert(data);
                                $('#btnSearch').click();
                            },
                            error: function (error) {
                                alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                            }
                        });
                    }
                }
             }
     </script>
