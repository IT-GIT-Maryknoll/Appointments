                        </tr>
                        <tr><td colspan="4">&nbsp;</td></tr>
                        <tr>
                            <td><label id="lblMPrep">Prep:</label></td>
                            <td>
                                <select id="cmbMPrep" name="cmbMPrep">
                                    @foreach (var res in Model.lstPreps )
                                    {
                                            <option value="@res.PrepID">@res.PrepName</option>
                                    }
                                </select>
                            </td>
                            <td><label id="lblMApptType">Appt Type:</label></td>
                            <td>
                                <select id="cmbMApptType" name="cmbMApptType">
                                    @foreach (var res in Model.lstAppointmentTypes)
                                    {
                                        if (Model.cmbApptType == res.Type)
                                        {
                                            <option value="@res.Type" selected>@res.Type</option>
                                        }
                                        else
                                        {
                                            <option value="@res.Type">@res.Type</option>
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td><label id="lblMNotes">Notes:</label></td>
                            <td colspan="3"><textarea id="txtMNotes" name="txtMNotes" class="form-control" rows="3"></textarea></td>
                        </tr>
                    </table>
                    <table style="width:100%; border-top:1px solid #dee2e6; margin-top:10px;">
                        <tr>
                            <td>
                                <div class="modal-sm" id="divEdit" style="vertical-align:top;">
                                    Modified on:&nbsp;<label id="lblMEditDate"></label>&nbsp;&nbsp;by:&nbsp;<label id="lblMEditBy"></label><br />
                                    Created on:&nbsp;<label id="lblMCreateDate"></label>&nbsp;&nbsp;by:&nbsp;<label id="lblMCreateBy"></label>
                                </div>
                            </td>
                            <td>
                                <div class="modal-static">
                                    <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                                    <button type="button" id="cmdDelete" class="btn btn-primary" data-bs-dismiss="modal" onclick="deleteAppointment(); clearForm();">Delete</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="clearForm();">Close</button>
                                </div>
                            </td>
                        </tr>
                    </table>

            </form>
        </div>

        </div>
    </div>
 </div>

