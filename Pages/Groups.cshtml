                                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12" style="background-color:white;vertical-align:top">
                                    <table class="filterBar" style="width:100%">
                                        <tr>
                                            <td>
                                                 <table class="filterBar" style="width:100%">
                                                    <tr>
                                                        <td style="font-size:18px; font-weight:bold; text-align:left">Group Members</td>
                                                        <td style="text-align:right;"><input type="button" class="btn btn-sm btn-success" value="Remove Selected" onclick="removeGroupMembers($('#txtGroupID').val());" /></td>
