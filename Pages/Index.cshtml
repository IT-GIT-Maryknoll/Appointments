@if (!bView)
{
    bool bHasAccess = false;
    foreach (var sTab in Model.lstTables)
    {
        var sMask = ViewData[sTab + "AccessMask"]?.ToString() ?? "";
        if(sMask != null && sMask.Length > 0) {
            bHasAccess = true;
            Response.Redirect("/" + sTab); 
            break;
        }
    }
     if(!bHasAccess)
     {
         Response.Redirect("/NoPermission");
     }
}
