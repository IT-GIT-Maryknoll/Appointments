<h3 style="text-align: center; font-size: 25px">Appointments Calendar</h3>
<form id="frm" name="frm" method="post">
<table>
    <tr>
    <td style="vertical-align:top;width:10%;padding:5px;">
        <table style="margin: 5px; background-color:lightgoldenrodyellow;">
                <tr><td colspan="2" style="font-weight:bold; color: #336699;"><h4>Select Appointment Criteria</h4></td></tr>
            <tr><td><label id="lblDate">Date:</label></td><td><input type="month" id="dtpSelector" name="lblDate" required="required" value="@Model.lblDate" /></td></tr>
                <tr>
                    <td><label id="lblResident">Resident:</label></td>
                    <td>
                        <input type="hidden" id="hdnResident" name="hdnResident" value="@Model.hdnResident" />
                        <input type="text" list="dlResident" id="txtResident" name="txtResident" value="@Model.txtResident" autocomplete="off" onchange="ChangeFilter(this);" />
                <datalist id="dlResident" name="lblResident">
                <option value="" label="Please Select" />            
                @foreach(var res in Model.lstResidents)
                            {
                                <option value="@res.ResidentKey" label="@res.FullName" />
                            }
                 </datalist>
                    </td></tr>
                <tr>
                    <td><label id="lblDoctor">Doctor:</label></td>
                    <td>
                        <input type="hidden" id="hdnDoctor" name="hdnDoctor" value="@Model.hdnDoctor" />
                        <input type="text" list="dlDoctor" id="txtDoctor" name="txtDoctor" value="@Model.txtDoctor" autocomplete="off" onchange="ChangeFilter(this);" />
                <datalist id="dlDoctor" name="lblDoctor" >
                            <option value="" label="Please Select" />
                            @foreach (var res in Model.lstDoctors)
                            {
                                <option value="@res.DoctorKey" label="@res.DoctorName" />
                            }
                        </datalist>
            </td></tr>
            <tr><td><label id="lblApptType">Type:</label></td><td><select id="cmbApptType" name="cmbApptType" >
                            <option value="" >Please Select</option>
                            @foreach (var res in Model.lstAppointmentTypes)
                            {
                                    if(Model.cmbApptType == res.Type)
                                    {
                                        <option value="@res.Type" selected>@res.Type</option>
                                    }
                                    else {
                                        <option value="@res.Type">@res.Type</option>
                                    }
                            }
                            </select>
            </td></tr>
@*             <tr><td><label id="lblAuditOnly">Audit Only:</label></td><td><input type="checkbox" id="chkAuditOnly" name="lblAuditOnly" /></td></tr>
 *@            <tr><td colspan="2" align="center"><input type="submit" id="btnSearch" class="btn btn-primary" value="Search" />&nbsp;&nbsp;&nbsp;
                            <input type="button" class="btn btn-secondary" id="btnReset" value="Reset" onclick="clearFilter();" />
                        </td>
                    </tr>
        </table>
    </td>
        <td><div id="calendar" style="padding: 5px;"></div></td>
    </tr>
</table>
</form>


<div id="myModal" class="modal fade" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle" class="modal-title fs-5" >New Appointment</h2>
                @* <button type="button" class="close" data-bs-dismiss="modal">&times;</button> *@
             </div>
                <div class="modal-body">
                <form id="frmAddEdit" name="frmAddEdit" class="col-md-12 form-horizontal">
                    <input type="hidden" id="hdnEventID" name="hdnEventID" value="" />
                    <table class="table table-borderless">
                        <tr>
                            <td style="padding:10px; align-content:flex-end;">Date:</td><td style ="padding:10px; align-content:flex-start;"><input type="date" id="txtMDate" name="txtDate" class="form-control" /></td>
                            <td style="padding:10px; align-content:flex-end;">Time:</td>
