@{
    ViewData["Title"] = "Group Members";
}
<style type="text/css">
    .lit {
        color: red;
        font-size: x-large;
    }
   
    .filterBar {
        background-color: white; /*#D1DCEB; */
        vertical-align: middle;
        text-align: right;
        padding: 9px;
        /* width: 99%; */
        height: 50px;
    }

    .btn {
        background-color: #0073F9;
        color: white;
        border: none;
        padding: 5px 10px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 12px;
        margin: 4px 2px;
        cursor: pointer;
    }

    .btn:hover {
        background-color: #0073F9;
        color: white;
        border: none;
        padding: 5px 10px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
   /*      font-size: 16px; */
        margin: 4px 2px;
        cursor: pointer;
    }

    
    tr:nth-child(even) {
        background-color: #E6E6E6;
    }

    .sticky-top-sub {
        position: -webkit-sticky;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .wrapper {
        position: relative;
        overflow-y: auto;
        z-index: 1;
        content: '';
    }

    .nav-items {
        color: white; /*#666666;*/
        background-color: floralwhite; /* #9BB7D4; */
        text-decoration: none;
        font-weight: bold;
/*         font-size: 18px;
        border: solid white 1pt; */
        cursor: pointer;
        padding: 4px;
    }

    .nav-links {
        display: block;
        width: 100%;
        text-decoration: none;
    }
    .nav-links:hover {
        background-color: lightslategray;
        text-decoration: none;
        font-weight: bold;
        color: white;
        /* font-size: 20px; */
        /* color: red; */
        }

    .nav-items.active {
        background-color: #D1DCEB;
        font-weight: bold;
        /* width: 100%; */
        color: royalblue;
        padding: 4px;
        white-space:nowrap;
    }

    .nav-items .nav-links.active {
        background-color: #D1DCEB;
        width: 100%;
        color: blue;
        padding: 4px;
    }
    a {
        color: #666666; 
    }

/*     .nav-tabs .nav-item.active,
    .nav-tabs .nav-item.show .nav-link {
        background-color: #D1DCEB;
        text-decoration: none;
        font-weight: bold;
        font-size: 20px;
        color: red;
    } */

    .fix-div {
        background-color: white;
        position: fixed;
        height: auto;
        width: 100%;
        left: 0;
        top: 0;
        z-index: 1;
    }

    .filterDiv {
        width: 100%;
    }

</style>
