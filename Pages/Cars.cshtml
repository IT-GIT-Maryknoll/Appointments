@page
@model Appointments.Pages.CarsModel
@{
    ViewData["Title"] = "Cars";

    bool bAdd = Model.sMask != null && Model.sMask.IndexOf("A") >= 0;
    bool bEdit = Model.sMask != null && Model.sMask.IndexOf("E") >= 0;
    bool bDelete = Model.sMask != null && Model.sMask.IndexOf("D") >= 0;
    var sCaption = bEdit ? "Edit" : "Details";
}
<body>
    <main style="height:stretch">
        <h3 style="text-align: center; font-size: 25px" id="hder">Cars</h3>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12" style="text-align: center; background-color:white; width: 99%">
            <div id="id_tablecars" class="row sticky-top" style=" width: 99%; overflow-y: auto; overflow-x: auto; padding-left: 5px; padding-right: 5px;">
                <table id="tblCars" class="table-striped" align="center">
                    <thead>
                        <tr id="tabletop" style="background-color: royalblue; color: white; font-size: 18px;">
                            <th></th>
                            <th>Make</th>
                            <th>Model</th>
                            <th>Type</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.lstCars)
                        {
                            <tr style="text-align:left;" data-carId="@car.CarNum">
                                <td>
                                    @if (bEdit)
                                    {
                                        <input type="button" id="btnEdit_@car.CarNum" value="Edit" class="btn btn-link" onclick="setEdit($(this).closest('tr'));" />
                                    }
                                    @if (bDelete)
                                    {
                                        <input type="button" id="btnDel_@car.CarNum" value="Delete" class="btn btn-link" onclick="setDelete($(this).closest('tr'));" />
                                    }
                                </td>
                                <td>@car.CarMake</td>
                                <td>@car.CarModel</td>
                                <td>@car.Type</td>
                                <td>@car.CarInfo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>
    <link href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.datatables.net/2.0.4/js/dataTables.min.js" defer></script>

    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js" defer></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js" defer></script>
@*     <script src="https://cdn.datatables.net/2.1.8/js/dataTables.jqueryui.js" defer></script> *@
            <script src="https://cdn.datatables.net/buttons/3.2.0/js/dataTables.buttons.js" defer></script>
      <script src="https://cdn.datatables.net/buttons/3.2.0/js/buttons.jqueryui.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/3.2.0/js/buttons.html5.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/3.2.0/js/buttons.print.min.js" defer></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var bAdd = @bAdd.ToString().ToLower();
            bAdd = (bAdd === "true");
            var arr = [
                { extend: 'copy', className: 'btn btn-primary' },
                { extend: 'csv', className: 'btn btn-primary' },
                { extend: 'excel', className: 'btn btn-primary' },
                { extend: 'pdf', className: 'btn btn-primary' },
                { extend: 'print', className: 'btn btn-primary' }
            ];

            if (bAdd) { 
                arr.unshift({ extends: 'button', className: 'btn btn-primary', id: 'btnNewCar', text: 'Add New', action: function () { setNew(); }});
            }

            $('#tblCars').dataTable({
                order: [[1, 'asc']],
                destroy: true,
                "sPaginationType": "full_numbers",
                scrollY: '400px',
                "iDisplayLength": 100,
                columnDefs: [
                    { targets: [0], searchable: false },
                    { targets: [0], orderable: false },
                ],
                layout: {
                    topstart: 'pageLength',
                    top: {
                        buttons: arr,
                    },
                    topend: 'search',
                    bottomend: 'paging',
                },
            });
         });

        function setEdit(trObj) {
            var carId = $(trObj).data(carId).carid;
            for(var i = 1; i < 5; i++){
                    var val = $(trObj).find("td").eq(i).text();
                    var tdObj = $(trObj).find("td").eq(i);
                    $(tdObj).data('originalValue', val);
                    $(tdObj).empty();
                    var input = $('<input type="text" class="form-control"  />').val(val);
                    $(tdObj).append(input);
            }

            var tdObj =$(trObj).find("td").eq(0);
            $(tdObj).empty();
            $(tdObj).html('<input type="button" id="btnUpdate_' + carId + '" value="Update" class="btn btn-link" onclick="setUpdate($(this).closest(\'tr\'), false);" />' +
                        '<input type="button" id="btnCancel_' + carId + '" value="Cancel" class="btn btn-link" onclick="setCancel($(this).closest(\'tr\'));" />');
            enableNew();
        }
        function setDelete(trObj) {
            var carId = $(trObj).data(carId).carid;
            if (!confirm('Are you sure you want to delete this car?')) {
                return;
            }
            DeleteCar(carId);
        }
        function setCancel(trObj) {
            var carId = $(trObj).data(carId).carid;
            var carmake = $(trObj).find("td").eq(1).data('originalValue');  
            var carmodel = $(trObj).find("td").eq(2).data('originalValue');  
            var cartype = $(trObj).find("td").eq(3).data('originalValue');
            var carinfo = $(trObj).find("td").eq(4).data('originalValue');

            $(trObj).find("td").eq(1).empty().text(carmake);
            $(trObj).find("td").eq(2).empty().text(carmodel);
            $(trObj).find("td").eq(3).empty().text(cartype);
            $(trObj).find("td").eq(4).empty().text(carinfo);

            var tdObj =$(trObj).find("td").eq(0);
            $(tdObj).empty();
            var bEdit = @bEdit.ToString().ToLower();
            //bEdit = (bEdit === "true"); 
            var bDelete = @bDelete.ToString().ToLower();
            //bDelete = (bDelete === "true");
            var html = '';
            if (bEdit) {
                html += '<input type="button" id="btnEdit_' + carId + '" value="Edit" class="btn btn-link" onclick="setEdit($(this).closest(\'tr\'));" />';
            }
            if (bDelete) {
                html += '<input type="button" id="btnDel_' + carId + '" value="Delete" class="btn btn-link" onclick="setDelete($(this).closest(\'tr\'));" />';
            }
            $(tdObj).html(html);
            enableNew();
        }
        function setUpdate(trObj, bNew) {
            var carId = $(trObj).data(carId).carid;
            var carmake = $(trObj).find("td").eq(1).find("input").val();
            var carmodel = $(trObj).find("td").eq(2).find("input").val();
            var cartype = $(trObj).find("td").eq(3).find("input").val();
            var carinfo = $(trObj).find("td").eq(4).find("input").val();
            if(SaveCar(trObj, bNew)){
                $(trObj).find("td").eq(1).empty().text(carmake);
                $(trObj).find("td").eq(2).empty().text(carmodel);
                $(trObj).find("td").eq(3).empty().text(cartype);
                $(trObj).find("td").eq(4).empty().text(carinfo);

                var tdObj =$(trObj).find("td").eq(0);
                $(tdObj).empty();
             var bEdit = @bEdit.ToString().ToLower();
            //bEdit = (bEdit === "true");
            var bDelete = @bDelete.ToString().ToLower();
            //bDelete = (bDelete === "true");
            var html = '';
            if (bEdit) {
                html += '<input type="button" id="btnEdit_' + carId + '" value="Edit" class="btn btn-link" onclick="setEdit($(this).closest(\'tr\'));" />';
            }
            if (bDelete) {
                html += '<input type="button" id="btnDel_' + carId + '" value="Delete" class="btn btn-link" onclick="setDelete($(this).closest(\'tr\'));" />';
            }
            $(tdObj).html(html);
                // $(tdObj).html('<input type="button" id="btnEdit_' + carId + '" value="Edit" class="btn btn-link" onclick="setEdit($(this).closest(\'tr\'));" />' +
                //             '<input type="button" id="btnDel_' + carId + '" value="Delete" class="btn btn-link" onclick="setDelete($(this).closest(\'tr\'));" />');
                enableNew();
            }
        }
        function setNew(){
            var carId = 0;
            var row = document.getElementById("tblCars").insertRow(0);  //          .rows.add().draw().node();
            for(var i = 0; i<5; i++){
            var  cell = row.insertCell(i);
            switch(i){
                case 0:
                    $(cell).html('<input type="button" id="btnUpdate_' + carId + '" value="Create" class="btn btn-link" onclick="setUpdate($(this).closest(\'tr\'), true);" />' +
                        '<input type="button" id="btnCancel_' + carId + '" value="Cancel" class="btn btn-link" onclick="$(this).closest(\'tr\').remove(); enableNew();" />');
                    break;
                default:
                    var input = $('<input type="text" class="form-control" />');
                    $(cell).append(input);
                }
            }
            enableNew();
            row.scrollIntoView({
                behavior: 'smooth', // Smooth animation
                block: 'nearest', // Vertical alignment
                inline: 'nearest' // Horizontal alignment
            });
        }
        function enableNew(){
            var cnt = ($('input[value="Update"]').length > 0 || $('input[value="Create"]').length > 0);
            var t = $('#tblCars').DataTable();
            if(cnt) t.buttons().disable();
            else t.buttons().enable();
        }
        function SaveCar(trObj, bNew)
        {
            var carId = $(trObj).data(carId).carid;
            var carmake = $(trObj).find("td").eq(1).find("input").val();
            var carmodel = $(trObj).find("td").eq(2).find("input").val();
            var cartype = $(trObj).find("td").eq(3).find("input").val();
            var carinfo = $(trObj).find("td").eq(4).find("input").val();

           if(carmake.trim().length == 0){
                alert("Car Make is required");
                return false;
            }
            document.getElementById("msg").innerHTML = "";
            $.ajax({
                type: "GET",
                url: "Cars?handler=SaveCar",
                data: { carInfo: carinfo, carMake: carmake, carNum: carId, carModel: carmodel, carType: cartype, isNew: bNew },
                success: function (data) {
                    document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:green;";
                    document.getElementById("msg").innerHTML = "The Car is saved successfully!";
                    location.reload();
                    return true;
                },
                error: function (xhr, status) {
                    document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                    document.getElementById("msg").innerHTML = "ERROR: " + status + ", " + xhr.statusText;
                    return false;
                }
            });
        }
        function DeleteCar(id)
        {
            document.getElementById("msg").innerHTML = "";
            $.ajax({
                type: "GET",
                url: "Cars?handler=DeleteCarById",
                data: { id: id },
                success: function (data) {
                    document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:green;";
                    document.getElementById("msg").innerHTML = "The Nurse is deleted successfully!";
                    location.reload();
                    return true;
                },
                error: function (xhr, status) {
                    document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                    document.getElementById("msg").innerHTML = "ERROR: " + status + ", " + xhr.statusText;
                    return false;
                }
            });
        }
        function formatDate(sDate){
            if(sDate == null || sDate == '')
                return '';
            var date = new Date(sDate);
            if(date.getFullYear() <1900)
                    return '';
            var month = (date.getMonth() + 1).toString().padStart(2, '0');
            var day = date.getDate().toString().padStart(2, '0');
            var year = date.getFullYear();
            var hours = date.getHours().toString().padStart(2, '0');
            var minutes = date.getMinutes().toString().padStart(2, '0');
            return month + '/' + day + '/' + year + ' ' + hours + ':' + minutes;
        }
        function gridHeight() {
            var iRet = screen.availHeight;
                iRet = iRet - document.getElementById('appHeader').offsetHeight;
                iRet = iRet - document.getElementById('appFooter').offsetHeight;
                iRet = iRet - document.getElementById('hder').offsetHeight;
        return iRet - 400; // screen.availHeight - document.getElementById('appHeader').offsetHeight - document.getElementById('appFooter').offsetHeight - 100;
        }
    </script>
}