<script type="text/javascript">
    function GroupItemClick(GroupID) {
        //try { GroupCancelClick(); } catch (e) { }
        $("#txtGroupID").val(GroupID);
        // document.getElementById('lstNewGroup').setAttribute('liID', GroupID);
        // loadGroupMembers(GroupID);
        // loadNonMembers(GroupID);
        // document.getElementById('btnDeleteGroup').disabled = (GroupID <= 0);
        // document.getElementById('btnEditGroup').disabled = (GroupID <= 0);

        GroupPermissionClick(GroupID);

        const items = document.querySelectorAll('.nav-links');
        items.forEach(item => item.classList.remove('active'));
        document.getElementById("grp_" + GroupID).classList.add('active');
    }
    
    $(document).ready(function () {
        //doResize('permissions');
        var firstGroupID = @Model.lstGroups.FirstOrDefault()?.GroupID ?? 0;
        if(firstGroupID !=0) {
            GroupItemClick(firstGroupID);
        }
    });
           
    function GroupPermissionClick(GroupID) {
            $.ajax({
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            url: 'Permissions?handler=GetPermissionList&GroupID=' + GroupID,
            type: 'GET',
            success: function (result) {
                document.getElementById("divPermissions").style = "display:bock;";
                DisplayPermissions(result);
            },
            error: function (xhr, status) {
                document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                document.getElementById("msg").innerHTML = "ERROR: " + status + ", " + xhr.statusText;
            }
        });
    }
        function SavePermissions(GroupID) {
            var dict = {};
            if (GroupID == 0) return;

            $('input[name=checkPerm]', "#tblGroupPermissions").each(function () {
                var chk = $(this).is(':checked');
                var chkId = $(this).attr('id');
                var arrId = chkId.split("*");

                if (arrId.length == 3) {
                    var perm = arrId[1]; var tbl = arrId[2];
                    if (chk) {
                        var chkId = $(this).attr('id');
                        if (dict[tbl] == null) dict[tbl] = "";
                        dict[tbl] = dict[tbl] + perm;
                    }
                    else {
                        if (dict[tbl] == null) dict[tbl] = "";
                    }
                }
            });

            $.ajax({
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                url:  'Permissions?handler=SavePermissions&GroupID=' + GroupID + "&PermList=" + JSON.stringify(dict), 
                type: 'GET',
                success: function () {
                    GroupPermissionClick(GroupID);
                   document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:green;";
                   document.getElementById("msg").innerHTML = "Permissions changed successfully!";
                   // GetTempData();
                },
                error: function (xhr, status) {
                   document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                   document.getElementById("msg").innerHTML = "ERROR: " + status + ", " + xhr.statusText;
                 //   GetTempData();
                }
            });
        }
        function DisplayPermissions(result){
            $('input[name=checkPerm]', "#tblGroupPermissions").prop("checked", false);
            for (var rec in result) {
                var perms = result[rec].accessMask; var tbl = result[rec].tableName;
                for (var i = 0; i < perms.length; i++) {
                    var perm = perms[i];
                    var chkId = "check*" + perm + "*" + tbl;
                    $("input[id='" + chkId + "']", "#tblGroupPermissions").prop("checked", true);
                }
            }
        }
        function CheckColumn(obj) {
            var tblName = obj.id.substring(8);  // obj.id.replace('check_', '');
            var bChecked = $("input[id$='check*A*" + tblName + "']", "#tblGroupPermissions").is(':checked') || 
                                    $("input[id$='check*E*" + tblName + "']", "#tblGroupPermissions").is(':checked') ||
                                    $("input[id$='check*D*" + tblName + "']", "#tblGroupPermissions").is(':checked');
             if(bChecked) $("input[id='check*V*" + tblName + "']", "#tblGroupPermissions").prop("checked", true);
        }
 </script>
