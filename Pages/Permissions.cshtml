                <input type="hidden" id="txtGroupID" />
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12" style="background-color:white;vertical-align:top">
                    <table id="id_tableusergroups" class="table-borderless" style="width:90%; background-color:white;">
                        <tbody>
                            <tr><td colspan="6" align="center"><h3 style="text-align: center; vertical-align:top; font-size: 25px">Group Permissions</h3></td></tr>
                            <tr>
                            <td style="font-size:18px; font-weight:bold; text-align:left; background-color:white;">Groups</td>
                                <td style="text-align:right; background-color:white;" >
                                    <input type="submit" class="btn btn-primary" id="btnSavePerm"
                                       onclick="SavePermissions($('#txtGroupID').val());" value="Save" />&nbsp;&nbsp;
                                    <input type="button" class="btn btn-primary" id="btnResetPerm"
