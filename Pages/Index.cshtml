             function saveAppointment() {
                var sMsg = "";
                if ($('#hdnMRes').val().length == 0) sMsg += "Please select resident. ";
                if ($('#hdnMDoc').val().length == 0) sMsg += "Please select doctor. ";
                 if($('#chkReccuring').prop('checked')){
                   if ($('#txtMStartDate').val() == "") sMsg += "Please select start date.";
                   if ($('#txtMEndDate').val() == "") sMsg += "Please select end date. ";
                   if(sMsg.length == 0 && $('#txtMEndDate').val() < $('#txtMStartDate').val()) sMsg += "End date cannot be earlier than start date. ";
                   var isAnyDaySelected = $('#chkSun').prop('checked') || $('#chkMon').prop('checked') || $('#chkTue').prop('checked') || $('#chkWed').prop('checked') || $('#chkThu').prop('checked') || $('#chkFri').prop('checked') || $('#chkSat').prop('checked');
                   if (!isAnyDaySelected) sMsg += "Please select at least one day. ";
                 }
                 else {
                    if ($('#txtMDate').val() == "") sMsg += "Please select date.";
                    if ($('#txtMTime').val() == "") sMsg += "Please select time. ";
                 }
             if (sMsg.length > 0) {
                   document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                   document.getElementById("msg").innerHTML = "ERROR: " + sMsg;
                   alert(sMsg);
                   return false;
               }

               var bRes = true; sMsg = "";
               if($('#chkReccuring').prop('checked')) {
                      var startDate = new Date($('#txtMStartDate').val());
                      var endDate = new Date($('#txtMEndDate').val());
                      while(startDate <= endDate) {
                          var dayOfWeek = startDate.getDay();
                          if ($('#chkSun').prop('checked') && dayOfWeek == 0 ||
                              $('#chkMon').prop('checked') && dayOfWeek == 1 ||
                              $('#chkTue').prop('checked') && dayOfWeek == 2 ||
                              $('#chkWed').prop('checked') && dayOfWeek == 3 ||
                              $('#chkThu').prop('checked') && dayOfWeek == 4 ||
                              $('#chkFri').prop('checked') && dayOfWeek == 5 ||
                              $('#chkSat').prop('checked') && dayOfWeek == 6) {
                                  // Save the appointment for this date
                                  $('#txtMDate').val(startDate.toISOString().substring(0, 10));
                                  var frm = $('#frmAddEdit');
                                  $.ajax({
                                      type: "POST",
                                      url: "index?handler=SaveAppointment",
                                      type: frm.attr('method'),
                                      data: frm.serialize(),
                                      success: function (data) {
                                          // Appointment saved successfully
                                      },
                                      error: function (xhr, status) {
                                          sMsg +="ERROR: " + status + ", " + xhr.statusText;
                                          bRes = false;
                                      }
                                  });
                          }
                          startDate.setDate(startDate.getDate() + 1);
                      }
                      if(!bRes) {
                          document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                          document.getElementById("msg").innerHTML = sMsg;
                          alert(sMsg);
                          return false;
                      }
                      else {
                          document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:green;";
                          document.getElementById("msg").innerHTML = "The Appointments are saved successfully!";
                          $('#myModal').modal('hide');
                          $('#btnSearch').click();
                          return true;
                      }
               }
               else {
                   var frm = $('#frmAddEdit');
                document.getElementById("msg").innerHTML = "";
                $.ajax({
                    type: "POST",
                    url: "index?handler=SaveAppointment",
                    type: frm.attr('method'),
                    data: frm.serialize(),
                    success: function (data) {
                   document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:green;";
                   document.getElementById("msg").innerHTML = "The Appointment is saved successfully!";
                        $('#myModal').modal('hide');
                        $('#btnSearch').click();
                        return true;
                    },
                    error: function (xhr, status) {
                       document.getElementById("msg").style = "padding:0px;text-align:center;font-weight:bold;color:red;";
                       document.getElementById("msg").innerHTML = "ERROR: " + status + ", " + xhr.statusText;
                   }

                });
          }
    }
