<script src="~/js/site.js"></script>
<script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>
<link href="https://cdn.datatables.net/2.0.4/css/dataTables.dataTables.css" rel="stylesheet" type="text/css" />
<script src="https://cdn.datatables.net/2.0.4/js/dataTables.min.js" defer></script>


<script type="text/javascript">

    $(document).ready(function () {
        loadGroups();  
    });
    function loadGroups() {
        //alert($("#lstGroups").find("option").length);
        //$("#lstGroups").find("option").remove();
        document.getElementById("lstGroups").innerHTML = "<li id=\"lstNewGroup\" class=\"nav-items active\" liID=\"0\" style=\"display: none; \">" +
            "<input type = \"text\" id = \"txtNewGroupName\" style = \"width:160px;display: inline-block;\" onchange = \"document.getElementById('btnNewGroup').disabled = this.value.trim().length==0\" />&nbsp;&nbsp;" +
            "<input id=\"btnNewGroup\" type=\"button\" class=\"btn btn-sm\" onclick=\"var sLabel = document.getElementById('txtNewGroupName').value; ChangeGroups(0, sLabel, false); \" value=\"Save\" /></li >";
            $.ajax({
            type: "GET",
            url: "Groups?handler=GetGroups",
            success: function (data) {
                $.each(data, function (i, v) {
                    $('#lstGroups').append("<li id='lstGroup_" + v.groupID + "' class='nav-items'><a id='grp_" + v.groupID + "' class='nav-links' data-toggle='tab' onclick='GroupItemClick(" + v.groupID + ");'>" + v.label + "</a></li>");
                    $('#lstGroups').append("<li id='lstEditGroup_" + v.groupID + "' class='nav-items active' style='display:none;'>" +
                        "<input type=\"text\" id=\"txtEditGroupName_" + v.groupID + "\" style=\"width: 160px;display: inline-block;\" value=\"" + v.label + "\" onchange=\"document.getElementById('btnEditGroup').disabled = (this.value.trim().length==0);\" />&nbsp;&nbsp;" +
                        "<input id=\"btnEditGroup\" type=\"button\" class=\"btn  btn-sm\" onclick=\"ChangeGroups(document.getElementById('lstNewGroup').getAttribute('liID'), document.getElementById('txtEditGroupName_" + v.groupID + "').value, false);\" value=\"Save\" /></li>");
                })
            },
            error: function (error) {
                console.log('Error populating house selector on save modal', error);
                alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
            }
        });
    }
    function loadGroupMembers(GroupID) {
        $('#tblGroupMembers').dataTable({
            destroy: true,
            "sPaginationType": "full_numbers",
            scrollY: '300px',
            "iDisplayLength": 10,

            ajax: {
                type: "GET",
                url: "Groups?handler=GetMembers",
                data: { GroupID },
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "sAmaccountName",
                    "render": function (data, type, row, meta) {
                        var defaultContent = "";
                        var sid = "checkUserMember_" + data;
                        if (type === 'display') {
                            defaultContent = '<input type="checkbox" name="checkUserMember" id="' + sid + '" />';
                        }
                        return defaultContent;
                    },
                    orderable: false
                },
                { "data": "lastName" },
                { "data": "firstName" },
                { "data": "middle" },
                /*{ "data": "displayName" },*/
                { "data": "sAmaccountName" },
                { "data": "employee_Member_Ind" },
                { "data": "employee_Member_Number" },
            ],
        });
    }
    function loadNonMembers(GroupID) {
        $('#tblUserList').dataTable({
            destroy: true,
            "sPaginationType": "full_numbers",
            scrollY: '300px',
            "iDisplayLength": 10,

            ajax: {
                type: "GET",
                url: "Groups?handler=GetUsers",
                data: { GroupID },
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "sAmaccountName",
                    "render": function (data, type, row, meta) {
                        var defaultContent = "";
                        var sid = "checkUser_" + data;
                        if (type === 'display') {
                            defaultContent = '<input type="checkbox" name="checkUser" id="' + sid + '" />';
                        }
                        return defaultContent;
                    },
                    orderable: false
                },
                { "data": "lastName" },
                { "data": "firstName" },
                { "data": "middle" },
                /*{ "data": "displayName" },*/
                { "data": "sAmaccountName" },
                { "data": "employee_Member_Ind" },
                { "data": "employee_Member_Number" },
            ],
        });
    }
    function GroupItemClick(GroupID) {
        try { GroupCancelClick(); } catch (e) { }
        $("#txtGroupID").val(GroupID);
        document.getElementById('lstNewGroup').setAttribute('liID', GroupID);
        loadGroupMembers(GroupID);
        loadNonMembers(GroupID);
        document.getElementById('btnDeleteGroup').disabled = (GroupID <= 0);
        document.getElementById('btnEditGroup').disabled = (GroupID <= 0);

        const items = document.querySelectorAll('.nav-links');
        items.forEach(item => item.classList.remove('active'));
        document.getElementById("grp_" + GroupID).classList.add('active');
    }
    function GroupAddClick() {
        try { GroupCancelClick(); } catch (e) { }
        document.getElementById('btnCancelAdd').style = 'display:inline';
        document.getElementById('lstNewGroup').style = 'display:inline';
    }
    function GroupEditClick() {
        try { GroupCancelClick(); } catch (e) { }
        var controlName = "lstGroup_" + document.getElementById("lstNewGroup").getAttribute("liID");
        document.getElementById(controlName).style = "display:none";
        controlName = "lstEditGroup_" + document.getElementById("lstNewGroup").getAttribute("liID");
        document.getElementById(controlName).style = "display:inline";
        document.getElementById('btnCancelAdd').style = 'display:inline';
    }
    function GroupDeleteClick() {
        ChangeGroups(document.getElementById('lstNewGroup').getAttribute('liID'), 'delete', true);
    }
    function GroupCancelClick() {
        var n = document.getElementById("lstNewGroup").getAttribute("liID");
        if (n != null && n != 0) {
            var controlName = "lstGroup_" + document.getElementById("lstNewGroup").getAttribute("liID");
            document.getElementById(controlName).style = "display:inline";
            controlName = "lstEditGroup_" + document.getElementById("lstNewGroup").getAttribute("liID");
            document.getElementById(controlName).style = "display:none";
        }
        document.getElementById('btnCancelAdd').style = 'display:none'; document.getElementById('lstNewGroup').style = 'display:none';
    }


    function removeGroupMembers(GroupID) {
        var loginList = '';

        $('input[name=checkUserMember]', "#tblGroupMembers").each(function () {
            var chk = $(this).is(':checked');
            if (chk) {
                var chkId = $(this).attr('id');
                var arrId = chkId.split("_");
                loginList += (loginList.length == 0 ? "" : ",") + arrId[1].toString();
            }
        });
        if (loginList != '') {
            if (confirm("Are you sure?, would you like to remove the selected record(s) from the group? ")) {
                $.ajax({
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    type: "GET",
                    url: "Groups?handler=RemoveMembers",
                    data: { GroupID, loginList },
                    success: function () {
                        loadGroupMembers(GroupID); loadNonMembers(GroupID);
                    },
                    error: function (error) {
                        console.log('Error populating house selector on save modal', error);
                        alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                    }
                });
            }
        }
        else {
            alert("Please select records to remove from the group.");
        }
    }
    function addGroupMembers(GroupID) {
        var loginList = '';
        $("input[name=checkUser]", "#tblUserList").each(function () {

            var chk = $(this).is(':checked');
            if (chk) {
                var chkId = $(this).attr('id');
                var arrId = chkId.split("_");
                loginList += (loginList.length == 0 ? "" : ",") + arrId[1].toString();
            }
        });
        if (loginList != '') {
            if (confirm("Are you sure?\n Would you like to add the selected record(s) to the group? ")) {
                $.ajax({
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    type: "GET",
                    url: "Groups?handler=AddMembers",
                    data: { GroupID, loginList },
                    success: function () {
                        loadGroupMembers(GroupID); loadNonMembers(GroupID);
                    },
                    error: function (error) {
                        console.log('Error populating house selector on save modal', error);
                        alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
                    }
                });
            }
        }
        else {
            alert("Please select records to add to the group.");
        }
    }
    function ChangeGroups(GroupID, GroupDescr, bDelete) {
        if (GroupDescr == null || GroupDescr.trim().length == 0) {
            alert("ERROR: Group description cannot be empty.");
            return false;
        }
        var sLabel = GroupDescr.trim();

        if (bDelete && GroupID <= 0) {
            alert("ERROR: Cannot delete non existent or system group.");
            return false;
        }
        $.ajax({
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            url: "Groups?handler=ChangeGroupList",
            type: "GET",
            data: { GroupID, sLabel, bDelete },
            success: function () {
                //reload and buttons manipulation
                //if (GroupID != 0)
                    $("#btnCancelAdd").click();
                //ClearGroups();
                loadGroups();
                // loadGroupMembers(0); loadNonMembers(0);
                 GroupItemClick(0);
                alert("The group is updated successfully!");
            },
            error: function (error) {
                console.log('Error populating house selector on save modal', error);
                alert(error.responseText.substring(0, error.responseText.indexOf('\n')).replace("System.SystemException:", ""));
            }
        });
    }
</script>