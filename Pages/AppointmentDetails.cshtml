@page
@model Appointments.Pages.AppointmentDetailsModel
@{
    var isCheckForAdmin = Model.IsAdmin;
    var driverName = Model.UserInfo.LastName+", "+Model.UserInfo.FirstName;
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@event-calendar/build@5.12.0/dist/event-calendar.min.css">

<link href="~/css/calendarview.css" rel="stylesheet" asp-append-version="true" />

    <div id="calendar-controls" class="no-print">
    <select id="calendar-month"></select>
    <select id="calendar-year"></select>
    <button id="go-button">Go</button>
    <input type="hidden" asp-for="SharedMessage" value="@isCheckForAdmin" />
    <input type="hidden" id="msgDriverName" value="@driverName" />
    @if(Model.IsAdmin){
        <div class="form-check">
        <input class="form-check-input" asp-for="ShowInhouse" />
        <label class="form-check-label" asp-for="ShowInhouse"> Show In-house </label>
        </div>}
    </div>

<div id="calendar"></div>

    <div id="eventModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
            <h2 id="m-title">Event Title</h2>
            </div>
            <div class="modal-body">
            <!-- Changed from <table> to a responsive <div> grid container -->
                <div class="modal-grid">

                    <div class="grid-item full-width">
                    <span class="label">Driver:</span>
                    <span id="m-location"></span>
                    </div>

                    <div class="grid-item full-width">
                    <span class="label">Doctor:</span>
                    <span id="m-doctor"></span>
                    </div>

                    <div class="grid-item full-width">
                    <span class="label">Date:</span>
                    <span id="m-date"></span>
                    </div>

                <!-- These will automatically sit side-by-side on tablet/desktop -->
                    <div class="grid-item">
                    <span class="label">Depart Time:</span>
                    <span id="m-start"></span>
                    </div>
                    <div class="grid-item">
                    <span class="label">Appoint Time:</span>
                    <span id="m-end"></span>
                    </div>

                <!-- These will automatically sit side-by-side on tablet/desktop -->
                    <div class="grid-item">
                    <span class="label">Wait:</span>
                    <span id="m-wait"></span>
                    </div>
                    <div class="grid-item">
                    <span class="label">Nurse Aid:</span>
                    <span id="m-nurseaid"></span>
                    </div>

                    <div class="grid-item full-width">
                    <span class="label">Address:</span>
                    <span id="m-description"></span>
                    </div>

                @if(Model.IsAdmin)
                    {
                        <div class="grid-item full-width">
                        <span class="label">Notes:</span>
                        <span id="m-notes"></span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
            <span class="close-btn" onclick="closeModal()">Close</span>
            </div>
        </div>
    </div>



<script src="https://cdn.jsdelivr.net/npm/@@event-calendar/build@5.12.0/dist/event-calendar.min.js"></script>
<script src="~/js/driversappts.js" asp-append-version="true"></script>