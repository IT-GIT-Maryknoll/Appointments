               function updateYearMonth() {
                   let date = $('#calendar').fullCalendar('getDate');
                   let year = date._d.getFullYear();
                   let month = date._d.getMonth() + 2;
                   if (month > 12) {
                       month = 1;
                       year += 1;
                   }

                   if (month < 10) {
                       month = "0" + month;
                   }

                   let nDate = year + '-' + month;
                   $('#dtpSelector').val(nDate);
                   FetchEventAndRenderCalendar(year, month);
               }
                  $('body').on('click', 'button.fc-next-button', function () {updateYearMonth(); $('#btnSearch').click();});

