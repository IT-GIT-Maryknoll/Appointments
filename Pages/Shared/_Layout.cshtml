<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <title>@ViewData["Title"] - Appointments</title>
    <script type="importmap"></script>
@*     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />*@   
    <link rel="stylesheet" href="~/css/site.css"  />
    @* <link rel="stylesheet" href="~/Appointments.styles.css" asp-append-version="true" /> *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://getbootstrap.com/docs/5.2/assets/css/docs.css" rel="stylesheet">
@*     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"></script> *@
        <style>
        .dropdown-item {
        font-size: 13.44px !important;
        color: #17264A !important;
        letter-spacing: 0.2px;
        line-height: 1.4em;
        font-family: 'Montserrat',Helvetica,Arial,Lucida,sans-serif;
        }

        .dropdown-menu {
        border-top-width: medium;
        border-top-color: red;
        }

        .dropdown-item:active {
        background-color: #e9ecef !important;
        }

        .footer {
        position: fixed;
        bottom: 0;
        height: 64px;
        text-align: center;
        background-color: #336699;
        font-size: 12px;
        line-height: 200%;
        color: white;
        /* margin-top: 300px;*/
        }

        .fntsize {
        font-size: 18px;
        }

        td {
        font-size: 16px;
        }

        input[type="text"] {
        font-size: 16px;
        }

        select {
        font-size: 16px;
        }

        a {
        font-size: 16px;
        }

        input[type=checkbox] {
        width: 20px;
        height: 20px;
        }



        </style>
</head>
<body>
   

    <header class="dontprint" id="appHeader">
            <nav class="navbar navbar-expand-lg bg-light">
                <div class="container-fluid nav-apostolic">
                    <div>
                    <img src="~/images/LogoFinale.png" width="312" height="64" />
                    <h2 style="display: inline-block; color: #336699; font-weight:bold; font-family: 'Montserrat',Helvetica,Arial,Lucida,sans-serif; padding-left: 80px; ">Appointments</h2>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    </div>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent" style="padding-left: 150px; ">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-1">
                            <li class="nav-item">
                                @* <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index"><div class="fntsize">Appointments</div></a> *@
                            <a class="nav-link" href="#" onclick="navigateScreen('Index');"><div class="fntsize">Appointments</div></a>
                            </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="navigateScreen('Doctors');"><div class="fntsize">Doctors</div></a>
                        </li>
@*                         <li class="nav-item">
                            <a class="nav-link" href="#" onclick="navigateScreen('Residents');"><div class="fntsize">Residents</div></a>
                        </li>
                            <li class="nav-item">
                            <a class="nav-link" href="#" onclick="navigateScreen('Nurses');"><div class="fntsize">Nurses</div></a>
                            </li> *@
                            <li class="nav-item">
                            <a class="nav-link" href="#" onclick="navigateScreen('Drivers');"><div class="fntsize">Drivers</div></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#" onclick="navigateScreen('Cars');"><div class="fntsize">Cars</div></a>
                            </li>
                            <li class="nav-item">
                            <a class="nav-link" href="#" onclick="navigateScreen('AppointmentDetails');"><div class="fntsize">Driver&Appt</div></a>
                            </li>
                        </ul>
                </div>
            </div>

       </nav>
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
                <td>
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="White" height="7" style="border-collapse: collapse">
                        <tr>
                            <td colspan="3" height="1" width="121%">
                                <font face="Arial, Arial, Helvetica">
                                    <div id="Layer1" style="position: absolute; left: 3px; top: 5px; width: 247px; height: 60px; z-index: 1">                                        
                                    </div>
                                </font>
                            </td>
                        </tr>
                        <tr>
                            <td align="left" colspan="3">
                                <div style="background-color: #336699; height: 21px;" />
                            </td>
                        </tr>
                        <tr height: 21px;>
                            <td style="width: 50px; background-color: #EEE1D1;  text-align: left; padding-left: 10px;color:chocolate; font-weight:bold;">@Model.UserInfo.DisplayName </td>
                            <td style="background-color: #EEE1D1; text-align: center; padding-left: 10px; padding-right:10px; ">
                                 @if (TempData["Message"] != null)
                                {
                                    if (TempData["Message"].ToString().StartsWith("ERROR"))
                                    {
                                        <div id="msg" style="padding:0px;text-align:center;font-weight:bold;" class="text-danger">@TempData["Message"]</div>
                                    }
                                    else
                                    {
                                        <div id="msg" style="padding:0px;text-align:center;font-weight:bold;color:limegreen" class="text-center">@TempData["Message"]</div>
                                    }
                                    TempData.Remove("Message");
                                }
                                else
                                { <div id="msg">&nbsp;</div>}
                            </td>
                            <td style="white-space:nowrap; background-color: #EEE1D1; text-align: right; padding-right: 10px; color:chocolate; font-weight:bold;">
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer id="appFooter" class="border-top footer text-muted" style="z-index: 1;">
        <div class="dontprint">
            <div class="footer">
                <span style="color: white;">
                    &copy; Copyright Maryknoll Fathers and Brothers 2024-2040
                </span>&nbsp;&nbsp;&nbsp;<br />
                <span>
                    Send Email to <a href="mailto:helpdesk@maryknoll.org" style="color: #99CCFF">helpdesk@maryknoll.org&nbsp;</a>
                    <span>with questions and comments about this website.</span>
                </span>
            </div>
            <div class="footer-row" style="margin-top: -22px !important;"></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> 
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function navigateScreen(screenName) {
            var sUrl = screenName;
            location.replace(sUrl);
        }
        </script>
</body>
</html>
